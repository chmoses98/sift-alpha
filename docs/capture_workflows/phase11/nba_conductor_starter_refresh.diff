+def test_starter_window_refreshes_on_every_five_minute_worker_cycle():
+    """Strict ``age > threshold`` against 300 s cycles: a context exactly one cycle old (5.0 min) must refresh, else the effective cadence is 10 min."""
+    now = datetime(2026, 11, 4, 23, 40, tzinfo=UTC)
+    rows = [{"game_id": "espn:1", "start_time_utc": "2026-11-05T00:10:00Z", "status": "scheduled"}]
+    kw = dict(capture_age_min=3, last_sim_age_min=5, last_settle_age_min=5, last_eval_age_min=5)
+    assert decide(now, rows, last_context_age_min=5.0, **kw)["context"] is True
+    assert decide(now, rows, last_context_age_min=3.9, **kw)["context"] is False     # never faster than the cycle
